# Copy to .env and fill in. Never commit .env. Placeholders only below.

# Organization API key with scopes ai-systems:write, agents:invoke and audit:read.
PRAESIDIA_API_KEY=replace-with-your-org-api-key
PRAESIDIA_ORG_ID=00000000-0000-0000-0000-000000000000
PRAESIDIA_AGENT_ID=00000000-0000-0000-0000-000000000000
# Optional. Defaults to https://api.praesidia.ai
PRAESIDIA_BASE_URL=https://api.praesidia.ai
# Optional; leave empty. Overrides PRAESIDIA_API_KEY for step 1 only, on a server
# older than the ai-systems:write scope; see README.
PRAESIDIA_INVENTORY_API_KEY=

# Stripe TEST mode only: the script refuses anything that is not sk_test_...
STRIPE_SECRET_KEY=sk_test_replace-me
# A test-mode charge (ch_...) or payment intent (pi_...) of exactly EUR 8,250.
STRIPE_CHARGE_ID=ch_replace-me

# Optional. Where the audit package ZIP is written.
AUDIT_PACKAGE_FILE=./audit-package.zip
# Optional; fill in the printed verify command. The Praesidia platform public key (PEM)
# and its SHA-256 fingerprint, obtained from Praesidia over a channel independent of the
# package. Never use the verifier's sample key or its fingerprint for a real package.
PRAESIDIA_PLATFORM_KEY_FILE=
PRAESIDIA_PLATFORM_KEY_FINGERPRINT=
