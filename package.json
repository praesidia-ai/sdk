{
  "name": "@praesidia/sdk",
  "version": "0.3.1",
  "description": "Open-source agent governance SDK for Praesidia \u2014 guardrail checks, audit logging, analytics",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/interop-research.md",
    "docs/protected-http.md",
    "LICENSE",
    "docs/federated-identity.md",
    "examples/protected-http-target.mjs",
    "docs/runtime-tools.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run && npm run test:plugins",
    "test:plugins": "bash scripts/test-plugins.sh",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck:spec": "tsc --noEmit -p tsconfig.spec.json",
    "lint:api-contract": "node scripts/audit-api-contract.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "praesidia",
    "ai-governance",
    "guardrails",
    "audit",
    "llm",
    "agent"
  ],
  "license": "Apache-2.0",
  "homepage": "https://praesidia.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/praesidia-ai/sdk"
  }
}
