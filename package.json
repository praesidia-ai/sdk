{
  "name": "@praesidia/sdk",
  "version": "0.4.0",
  "description": "Open-source agent governance SDK for Praesidia — guardrail checks, audit logging, analytics",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run && npm run test:plugins",
    "test:plugins": "bash scripts/test-plugins.sh",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck:spec": "tsc --noEmit -p tsconfig.spec.json",
    "lint:api-contract": "node scripts/audit-api-contract.mjs",
    "sbom": "npx --yes @cyclonedx/cyclonedx-npm@^2 --omit dev --output-format JSON --output-file sbom.cdx.json",
    "smoke:packed": "bash scripts/packed-install-smoke.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "keywords": [
    "praesidia",
    "ai-governance",
    "guardrails",
    "audit",
    "llm",
    "agent"
  ],
  "license": "Apache-2.0",
  "homepage": "https://praesidia.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praesidia-ai/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/praesidia-ai/sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
